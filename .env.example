# ==============================================================================
# SupportDesk - Environment Configuration Template
# Copy this file to .env and customize values for your local environment
# ==============================================================================

# Security
SECRET_KEY=django-insecure-replace-with-a-random-secure-key-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database Configuration (MySQL)
# Default MySQL port is 3306 (or 3307 if configured with separate service instance)
DB_ENGINE=mysql
DB_NAME=supportdesk_db
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_HOST=127.0.0.1
DB_PORT=3307
